# Copie para .env e preencha. O .env nunca entra no repositório.
# Nenhuma chave é obrigatória na fundação: o provedor falso roda tudo (DC-14).

# Provedor do serviço de linguagem: falso | (os reais entram no card N-13)
NARRADOR_PROVEDOR=falso

# Pasta local das aventuras importadas (fora do repositório e de sincronização em nuvem, RN-09)
NARRADOR_PASTA_AVENTURAS=

# Pasta local das campanhas (um arquivo SQLite por campanha)
NARRADOR_PASTA_CAMPANHAS=
